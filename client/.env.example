# Browser-safe values ONLY. Everything prefixed VITE_ is bundled into public JavaScript.
# Never put database credentials, JWT secrets or unrestricted API keys here.

# API base URL. Leave as /api to use the Vite dev proxy (recommended for local development).
VITE_API_BASE_URL=/api

# Google Maps JavaScript API key — RESTRICT it to HTTP referrers (e.g. http://localhost:5173/*)
# and to the Maps JavaScript API in Google Cloud Console. Leave empty to use the
# OpenStreetMap fallback map.
VITE_GOOGLE_MAPS_API_KEY=

# Optional Map ID from Google Cloud (Map Management). Not required.
VITE_GOOGLE_MAPS_MAP_ID=
