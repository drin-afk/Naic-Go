# ---------------- NaicGo server configuration ----------------
# Copy to .env and fill in. NEVER commit the real .env file.
NODE_ENV=development
PORT=5000

# MySQL (XAMPP default: user root, empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=naicgo_db
DB_USER=root
DB_PASSWORD=

# Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Origin of the React app (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Driver availability reports older than this are shown as "outdated"
AVAILABILITY_FRESH_MINUTES=120

# Evidence uploads (complaints)
UPLOAD_DIR=storage/evidence
UPLOAD_MAX_MB=5
UPLOAD_MAX_FILES=3

# Email verification: set true to require verified email before commuters can submit complaints
REQUIRE_EMAIL_VERIFICATION=false

# Optional SMTP (password reset / email verification). If SMTP_HOST is empty in
# development, links are printed to the server console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="NaicGo <no-reply@naicgo.local>"

# Set to true only when running behind a reverse proxy (production)
TRUST_PROXY=false
