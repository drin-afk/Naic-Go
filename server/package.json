{
  "name": "naicgo-server",
  "version": "1.0.0",
  "private": true,
  "description": "NaicGo REST API (Node.js + Express + MySQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "create-admin": "node src/scripts/createAdmin.js",
    "seed:demo-users": "node src/scripts/seedDemoUsers.js",
    "test": "node --test --test-concurrency=1 tests/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^7.0.9"
  },
  "devDependencies": {
    "supertest": "^7.1.0"
  }
}
